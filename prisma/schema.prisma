  S
  M
  L
  XL
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CharacterModerationStatus {
  APPROVED
  UNDER_REVIEW
  BLOCKED
