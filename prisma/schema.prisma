// Amorify — schema.
// Postgres extensions (vector, pg_trgm, pgcrypto, unaccent) live in the
// `extensions` schema and are installed via raw SQL in the initial migration,
// NOT via Prisma preview features (postgresqlExtensions was discontinued in
// Prisma v6.16+). See prisma/migrations/20260727100247_init/migration.sql.

// driverAdapters is stable in Prisma 7 — no preview flag required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth compatible) ───────────────────────────────────────────────

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)

  // Age gate & compliance
  ageConfirmedAt          DateTime?
  tosAcceptedAt           DateTime?
  privacyAcceptedAt       DateTime?
  contentPolicyAcceptedAt DateTime?
  signupIp                String?
  signupUserAgent         String?

  // Voice-call beta allowlist. Gate flipped on per-user by admins during the
  // first two weeks after launch, then removed once we're confident in the
  // provider bill and drop-reason distribution.
  voiceCallsBeta Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        UserProfile?
  characters     Character[]
  characterEdits CharacterEditHistory[] @relation("CharacterEditor")

  // Chat + memory back-relations
  conversations          Conversation[]
  memoryFacts            MemoryFact[]
  relationshipStates     RelationshipState[]
  relationshipMilestones RelationshipMilestone[]
  modelConfigUpdates     ModelConfig[]           @relation("ModelConfigUpdatedBy")
  callSessions           CallSession[]
  mediaGenerations       MediaGeneration[]
  aiPrefs                UserAiPrefs?

  @@index([email])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── User Profiles ────────────────────────────────────────────────────────────

model UserProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  displayName String?
  bio         String?
  avatarUrl   String?
  timezone    String?
  preferences Json    @default("{}")

  // Layer 3b explicit key-value facts injected into every LLM prompt: name,
  // birthday, pronouns, job, city — populated by the memory extractor when
  // it emits IDENTITY-category facts. See .agents/docs/memory-architecture.md
  // §7 for the design intent.
  structuredFacts Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Character Lookups (admin-editable seed data) ─────────────────────────────
//
// These live as tables (not Prisma enums) because product will iterate on the
// list — new personalities, occupations, and voices get added without a
// schema migration. Prompt fragments are stored server-side so the wizard
// UI only ever sees display metadata.

model PersonalityArchetype {
  id             String  @id @default(uuid()) @db.Uuid
  slug           String  @unique
  displayName    String
  description    String  @db.Text
  promptFragment String  @db.Text
  icon           String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters Character[]

  @@index([isActive, sortOrder])
  @@map("personality_archetypes")
}

model RelationshipArchetype {
  id             String  @id @default(uuid()) @db.Uuid
  slug           String  @unique
  displayName    String
  description    String  @db.Text
  promptFragment String  @db.Text
  icon           String?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters Character[]

  @@index([isActive, sortOrder])
  @@map("relationship_archetypes")
}

model CharacterOccupation {
  id             String  @id @default(uuid()) @db.Uuid
  slug           String  @unique
  displayName    String
  description    String? @db.Text
  promptFragment String  @db.Text
  icon           String?
  isNsfwOnly     Boolean @default(false)
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters Character[]

  @@index([isActive, sortOrder])
  @@index([isNsfwOnly])
  @@map("character_occupations")
}

model VoicePreset {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  displayName     String
  tone            String
  provider        VoiceProvider
  providerVoiceId String
  sampleR2Key     String?
  language        String        @default("en")
  // Gender presentation of the VOICE (Cartesia vocabulary:
  // "feminine" | "masculine" | "gender_neutral"). Drives the wizard's
  // gender-filtered voice picker — female characters list feminine
  // voices, male characters list masculine ones. Nullable so legacy
  // rows keep working until backfilled (null = shown to everyone).
  gender          String?
  // "young" | "mature" — heuristically classified from the Cartesia
  // description ("young adult female…", "Mature female…"). Null =
  // unknown, shown for every character age. Matched against the
  // wizard's ageBucket so a 45-year-old character doesn't offer
  // college-kid voices.
  ageGroup        String?
  // "conversational" | "support" | "narration" | "advertising" —
  // description-derived. Conversational voices rank first in the
  // picker; support-desk voices sink to the bottom (they're the
  // "IVR accent" the companion experience is trying to avoid).
  category        String?
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters Character[]

  @@index([isActive, sortOrder])
  @@map("voice_presets")
}

// ─── Characters ───────────────────────────────────────────────────────────────

model Character {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid

  // Hard-tier identity — immutable after DRAFT → ACTIVE. Enforced in app layer.
  name      String
  birthdate DateTime @db.Date

  // Wizard answers — appearance (screenshot 7 "Appearance" tab)
  baseStyle BaseStyle
  ethnicity Ethnicity
  gender    Gender
  ageYears  Int
  eyeColor  EyeColor
  hairStyle HairStyle
  hairColor HairColor
  bodyType  BodyType
  bustSize  SizeTier?
  hipSize   SizeTier?
  clothing  String?
  // Wizard v2 — style-of-dress preset that drives the wardrobe pool at
  // image generation time. Optional so pre-v2 rows (if any) don't break;
  // wizard v2 always writes it.
  fashionStyle FashionStyle?

  // Wizard answers — character (screenshot 7 "Character" tab)
  personalityArchetypeId  String @db.Uuid
  relationshipArchetypeId String @db.Uuid
  occupationId            String @db.Uuid
  voicePresetId           String @db.Uuid

  // Behavioral sliders (product-research.md §2.3, 0–100 each)
  flirtation     Int @default(50)
  patience       Int @default(50)
  moodVolatility Int @default(50)
  dominance      Int @default(50)

  // Discovery / classification
  language String   @default("en")
  hobbies  String[] @default([])
  tags     String[] @default([])
  nsfwOptIn Boolean @default(false)
  tagline  String?
  backstory String? @db.Text

  // Compiled artifacts — regenerated whenever mutable answers change.
  systemPrompt     String   @db.Text
  appearancePrompt String   @db.Text
  bio              String?  @db.Text
  promptCompiledAt DateTime

  // Lifecycle (screenshot 6 loading → screenshot 7 preview → "Bring my AI to Life")
  status              CharacterStatus @default(DRAFT)
  regenerationCount   Int             @default(0)
  committedAt         DateTime?

  // Moderation + visibility
  visibility       CharacterVisibility       @default(PRIVATE)
  moderationStatus CharacterModerationStatus @default(APPROVED)
  featuredAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerUser              User                         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  personalityArchetype   PersonalityArchetype         @relation(fields: [personalityArchetypeId], references: [id])
  relationshipArchetype  RelationshipArchetype        @relation(fields: [relationshipArchetypeId], references: [id])
  occupation             CharacterOccupation          @relation(fields: [occupationId], references: [id])
  voicePreset            VoicePreset                  @relation(fields: [voicePresetId], references: [id])
  appearanceProfiles     CharacterAppearanceProfile[]
  editHistory            CharacterEditHistory[]

  // Chat + memory back-relations
  conversations          Conversation[]
  memoryFacts            MemoryFact[]
  relationshipStates     RelationshipState[]
  relationshipMilestones RelationshipMilestone[]
  callSessions           CallSession[]
  mediaGenerations       MediaGeneration[]

  @@index([ownerUserId])
  @@index([ownerUserId, status])
  @@index([visibility, moderationStatus])
  @@index([featuredAt])
  @@map("characters")
}

model CharacterAppearanceProfile {
  id          String @id @default(uuid()) @db.Uuid
  characterId String @db.Uuid
  version     Int

  appearancePrompt String @db.Text

  referenceImageR2Key String?
  // Face embedding — 512-dim vector for identity-lock similarity search.
  // Prisma has no first-class type for pgvector; `Unsupported` marks the
  // column as inaccessible to the Prisma client, and we query it via raw SQL.
  faceEmbedding       Unsupported("vector(512)")?
  faceKeypoints       Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, version])
  @@index([characterId, isActive])
  @@map("character_appearance_profiles")
}

model CharacterEditHistory {
  id           String  @id @default(uuid()) @db.Uuid
  characterId  String  @db.Uuid
  editorUserId String  @db.Uuid
  tier         ConstraintTier
  fieldName    String
  oldValue     Json?
  newValue     Json?
  reason       String?

  createdAt DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  editor    User      @relation("CharacterEditor", fields: [editorUserId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@index([editorUserId])
  @@map("character_edit_history")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum BaseStyle {
  REALISTIC
  ANIME
  THREE_D
  CARTOON
}

enum Ethnicity {
  // Legacy coarse buckets — retained so pre-v2 admin data isn't
  // disturbed. New wizard emits the fine-grained values below.
  CAUCASIAN
  LATINA
  ASIAN
  ARAB
  EBONY
  MIXED
  OTHER
  // Wizard v2 (Candy.ai-style Heritage picker).
  EAST_ASIAN
  SOUTHEAST_ASIAN
  SOUTH_ASIAN
  MIDDLE_EASTERN
  NORTH_AFRICAN
  BLACK
  CARIBBEAN
  EUROPEAN
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
  TRANS_WOMAN
  TRANS_MAN
}

enum EyeColor {
  BROWN
  BLUE
  GREEN
  HAZEL
  AMBER
  GRAY
  VIOLET
  HETEROCHROMIA
}

enum HairStyle {
  STRAIGHT
  WAVY
  CURLY
  BANGS
  PONYTAIL
  BOB
  PIXIE
  BRAIDS
  UPDO
}

enum HairColor {
  BLACK
  BROWN
  BLONDE
  RED
  AUBURN
  WHITE
  SILVER
  PINK
  PURPLE
  BLUE
  FANTASY_OTHER
}

enum BodyType {
  SLIM
  ATHLETIC
  CURVY
  PLUS_SIZE
  PETITE
  VOLUPTUOUS
}

enum SizeTier {
  XS
  S
  M
  L
  XL
}

// Wizard v2 — Fashion step. Drives the wardrobe pool used by the image
// prompt builder and by the wizard's Fashion picker tile.
enum FashionStyle {
  CASUAL_CHIC
  ELEGANT
  STREETWEAR
  BOHEMIAN
  GOTH
  ANIME_FASHION
  SPORTY
}

enum CharacterStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CharacterVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CharacterModerationStatus {
  APPROVED
  UNDER_REVIEW
  BLOCKED
}

enum VoiceProvider {
  MOCK_TTS
  ELEVENLABS
  OPENAI_REALTIME
  CARTESIA
  PLAYHT
}

enum ConstraintTier {
  HARD
  TEMPORAL
  SOFT
  EMERGENT
}

// ─── Model Configuration (admin-tunable at runtime) ───────────────────────────
//
// Model IDs, endpoints, and per-model parameters live in Postgres — never in
// `.env` — so admins can swap chat/extractor/image models at runtime without
// a redeploy. Every LLM/image adapter resolves its model via this table.

model ModelConfig {
  id              String        @id @default(uuid()) @db.Uuid
  purpose         ModelPurpose  @unique
  provider        ModelProvider
  modelId         String
  endpoint        String?
  parameters      Json          @default("{}")
  label           String
  notes           String?       @db.Text
  isActive        Boolean       @default(true)
  updatedByUserId String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("ModelConfigUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([purpose, isActive])
  @@map("model_configs")
}

enum ModelPurpose {
  CHAT
  EXTRACTOR
  SUMMARIZER
  IMAGE_TEXT_TO_IMAGE
  IMAGE_IMAGE_TO_IMAGE
  VIDEO_IMAGE_TO_VIDEO
  EMBEDDING
  // Character-creation-time scenario/tagline copywriter. Produces the
  // 2-3 sentence Candy.ai-style hook stored on `characters.tagline` +
  // `.bio`. Kept as a distinct purpose so admins can point it at a
  // stronger creative-writing model (gpt-4o, Claude Haiku, etc.)
  // separately from the memory extractor.
  TAGLINE_GENERATOR
  // Voice-call pipeline. Three separate purposes because STT / LLM / TTS
  // each live at different providers and get tuned independently. The LLM
  // is a distinct row from CHAT so admins can point voice at a `:nitro`
  // variant for latency without disturbing text-chat routing.
  VOICE_STT
  VOICE_LLM
  VOICE_TTS
  // In-chat media generation — separate from the wizard portrait path so
  // admins can tune the chat-media model independently. EDIT variants use
  // reference-image-locked endpoints; TEXT_TO_* are the fallback when no
  // reference is available (sibling-swap rule).
  CHAT_IMAGE_EDIT
  CHAT_IMAGE_TEXT_TO_IMAGE
  CHAT_VIDEO_TEXT_TO_VIDEO
  CHAT_VIDEO_IMAGE_TO_VIDEO
}

enum ModelProvider {
  OPENROUTER
  OPENAI
  ANTHROPIC
  FAL
  DEEPGRAM
  CARTESIA
  LIVEKIT
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  characterId   String   @db.Uuid
  title         String?
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  character        Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages         Message[]
  summary          ConversationSummary?
  callSessions     CallSession[]
  mediaGenerations MediaGeneration[]

  @@unique([userId, characterId])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           MessageRole
  status         MessageStatus @default(READY)
  content        String        @db.Text
  tokensIn       Int?
  tokensOut      Int?
  // Snapshot of the ModelConfig.modelId that produced this row. Kept even if
  // an admin later swaps the active model, so history stays honest.
  modelId        String?
  errorMessage   String?

  // Voice-call plumbing. `source` distinguishes typed turns from spoken turns
  // so the composer knows whether the user actually saw the text or heard it
  // spoken (matters for how we replay a mixed thread). `audioR2Key` points at
  // the R2 blob (user's mic capture OR TTS output) when we're recording; null
  // for text turns. `ttsMarkupTags` captures the Cartesia inline markers the
  // LLM emitted (`[laugh]`, `[sigh]`, ...) for later analytics.
  source        MessageSource @default(TEXT)
  audioR2Key    String?
  ttsMarkupTags String[]      @default([])

  // Media generation link — set when this assistant message is a placeholder
  // for an in-progress or completed image/video generation. The UI renders the
  // MediaGeneration bubble instead of a text bubble when this is non-null.
  mediaGenerationId String? @db.Uuid

  createdAt DateTime @default(now())

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  extractedFacts  MemoryFact[]
  mediaGeneration MediaGeneration? @relation(fields: [mediaGenerationId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  READY
  FAILED
}

enum MessageSource {
  TEXT
  VOICE
}

model ConversationSummary {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @unique @db.Uuid
  summary        String @db.Text
  turnsCovered   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_summaries")
}

// ─── Media Generations (in-chat image / video) ────────────────────────────────

model MediaGeneration {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  characterId    String                @db.Uuid
  conversationId String                @db.Uuid
  kind           MediaKind
  status         MediaGenerationStatus @default(PENDING)

  // Prompt supplied by the user or extracted from the message.
  prompt String @db.Text

  // Enriched prompt actually sent to fal (includes identity, style, etc.).
  finalPrompt String? @db.Text

  // fal model slug that ran this generation.
  modelSlug String?

  // fal's queue request ID — used for resumable polling if the server
  // restarts mid-generation (stored as TEXT because fal IDs are opaque).
  providerRequestId String?

  // R2 key + public URL for the completed asset.
  storageKey String?
  storageUrl String?

  // Credit reservation: cost is locked at creation and released/charged
  // on completion. Consistent with the reservation pattern used by voice.
  costCredits Int @default(0)

  // Free-form bag: seed, style, aspectRatio, editMode, referenceMediaId.
  metadata Json @default("{}")

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([userId, characterId, status, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("media_generations")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── User AI Preferences ──────────────────────────────────────────────────────

model UserAiPrefs {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  // Per-user model slug overrides. Null means "use the admin default from
  // model_configs". Power users can paste a fal slug here; the UI is behind
  // a hidden advanced-defaults panel, never in the MediaComposer.
  imageModel String?
  videoModel String?

  // Aspect-ratio preferences. Null → per-kind defaults from src/config/media.ts.
  imageAspect String?
  videoAspect String?

  // Duration preference for video (seconds). Null → 5s default.
  videoDuration Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_prefs")
}

// ─── Memory (Layer 2 + Layer 3a) ──────────────────────────────────────────────

model MemoryFact {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  characterId     String?        @db.Uuid
  content         String         @db.Text
  category        MemoryCategory
  valence         Float          @default(0)
  confidence      Float          @default(0.8)
  sourceMessageId String?        @db.Uuid
  entities        String[]       @default([])
  metadata        Json           @default("{}")

  // 1024-dim embedding column ships now (nullable, no HNSW index yet). The
  // embedder + backfill + `CREATE INDEX` land as a follow-up migration.
  embedding Unsupported("vector(1024)")?

  extractedAt DateTime  @default(now())
  expiresAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceMsg Message?   @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@map("memory_facts")
}

enum MemoryCategory {
  IDENTITY
  PREFERENCE
  RELATIONSHIP
  EVENT
  PLAN
  EMOTION
  OPINION
  COMMITMENT
  OTHER
}

model RelationshipState {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  characterId       String           @db.Uuid
  trust             Float            @default(50)
  affection         Float            @default(50)
  respect           Float            @default(50)
  familiarity       Float            @default(0)
  tension           Float            @default(0)
  affinity          Float            @default(0)
  tier              RelationshipTier @default(STRANGER)
  lastInteractionAt DateTime         @default(now())
  totalMessages     Int              @default(0)
  streakDays        Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("relationship_states")
}

enum RelationshipTier {
  STRANGER
  ACQUAINTANCE
  FRIEND
  CLOSE_FRIEND
  ROMANTIC_INTEREST
  PARTNER
  SOULMATE
}

model RelationshipMilestone {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  characterId String   @db.Uuid
  type        String
  content     String   @db.Text
  metadata    Json     @default("{}")
  occurredAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, occurredAt(sort: Desc)])
  @@map("relationship_milestones")
}

// ─── Wizard v2 preview images ─────────────────────────────────────────────
// One row per (optionType, optionValue, baseStyle, gender) tuple. Feeds the
// visual pickers in the Candy.ai-style character wizard. Populated by an
// offline admin seeder script (Phase 3) that calls the fal.ai image model
// and uploads results to R2.

enum WizardOptionType {
  GENDER
  LOOK
  BOND
  PERSONALITY
  AGE_BUCKET
  ETHNICITY
  HAIR_COLOR
  HAIR_STYLE
  EYE_COLOR
  BODY_TYPE
  FASHION
}

model WizardOptionPreview {
  id              String           @id @default(uuid()) @db.Uuid
  optionType      WizardOptionType
  optionValue     String
  baseStyle       BaseStyle
  gender          Gender
  imageR2Key      String
  imageUrl        String
  promptSnapshot  String           @db.Text
  generatedAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedByUserId String?          @db.Uuid

  @@unique([optionType, optionValue, baseStyle, gender], map: "wizard_option_previews_unique")
  @@index([baseStyle, gender, optionType], map: "wizard_option_previews_style_gender_idx")
  @@map("wizard_option_previews")
}

// ─── Voice calls ──────────────────────────────────────────────────────────────
//
// One row per real-time call between a user and a character. The row is created
// eagerly at `POST /call/token` (so the concurrent-call guard has something to
// check) and finalized on hang-up. Turn transcripts land in `messages` with
// `source=VOICE` and share the parent `conversationId`, so a mixed
// text-and-voice thread reads back as one continuous conversation.

model CallSession {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  characterId    String    @db.Uuid
  // LiveKit room name — we mint it deterministically as `call_<sessionId>` so
  // both the token issuer and the agent worker can derive it without an extra
  // round trip.
  livekitRoom    String    @unique
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationSec    Int?
  turnCount      Int       @default(0)
  costCredits    Int       @default(0)
  // "user_hangup" | "user_disconnect" | "credit_exhausted" | "provider_error" |
  // "daily_cap_reached" | "concurrent_call_limit" — free-form so we can add
  // reasons without a migration.
  dropReason     String?
  // 2-sentence LLM recap generated in `after()` on hang-up. Feeds the memory
  // block on subsequent turns so the character can naturally say "That was a
  // nice call yesterday."
  summary        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, endedAt])
  @@map("call_sessions")
}
