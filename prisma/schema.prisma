generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth compatible) ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)

  // Age gate & compliance
  ageConfirmedAt      DateTime?
  tosAcceptedAt       DateTime?
  privacyAcceptedAt   DateTime?
  contentPolicyAcceptedAt DateTime?
  signupIp            String?
  signupUserAgent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  profile            UserProfile?
  companions         Companion[]
  conversations      Conversation[]
  creditWallet       CreditWallet?
  creditTransactions CreditTransaction[]
  creditReservations CreditReservation[]
  subscriptions      Subscription[]
  mediaGenerations   MediaGeneration[]
  moderationEvents   ModerationEvent[]
  adminAuditLogs     AdminAuditLog[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── User Profiles ────────────────────────────────────────────────────────────

model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  timezone    String?
  preferences Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Companions ───────────────────────────────────────────────────────────────

model Companion {
  id          String          @id @default(uuid())
  userId      String
  name        String
  status      CompanionStatus @default(ACTIVE)

  // Wizard Step 1: Identity
  companionType    String
  genderPresentation String
  ageStyle         String

  // Wizard Step 2: Details
  relationshipStyle String
  greetingStyle     String

  // Wizard Step 3: Personality
  personalityPreset   String?
  personalityTraits   Json    @default("{}")

  // Wizard Step 4: Appearance
  visualStyle   String
  hairColor     String
  hairstyle     String
  eyeColor      String
  buildStyle    String
  fashionStyle  String
  overallVibe   String
  customAppearanceNotes String?

  // Wizard Step 5: Chat Style
  conversationTone String
  intimacyLevel    String

  // Wizard Step 6: Memory Preferences
  memoryPreferences Json @default("{}")

  // Free-form metadata (e.g. defaultMediaSettings used to seed new conversations)
  metadata Json @default("{}")

  // Generated prompts
  systemPrompt     String? @db.Text
  appearancePrompt String? @db.Text

  // Avatar
  avatarUrl        String?
  avatarGeneratedAt DateTime?

  // Public template flag (set by admin/seed; visible to all users to clone)
  isPublic         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory        CompanionMemory?
  memoryVersions CompanionMemoryVersion[]
  conversations  Conversation[]
  mediaGenerations MediaGeneration[]

  @@index([userId])
  @@index([status])
  @@map("companions")
}

// ─── Memory ───────────────────────────────────────────────────────────────────

model CompanionMemory {
  id               String  @id @default(uuid())
  companionId      String  @unique
  userId           String
  memoryMarkdown   String  @db.Text
  memoryJson       Json?
  version          Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("companion_memories")
}

model CompanionMemoryVersion {
  id             String @id @default(uuid())
  companionId    String
  memoryMarkdown String @db.Text
  memoryJson     Json?
  version        Int
  changedBy      String
  changeReason   String?

  createdAt DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId])
  @@map("companion_memory_versions")
}

// ─── Conversations & Messages ─────────────────────────────────────────────────

model Conversation {
  id             String             @id @default(uuid())
  userId         String
  companionId    String
  title          String?
  status         ConversationStatus @default(ACTIVE)
  metadata       Json               @default("{}")
  lastMessageAt  DateTime?

  // Rolling summary of older messages used to keep persona/story consistent
  // when conversations grow beyond the live context window.
  summary                  String? @db.Text
  summaryThroughMessageId  String?
  summaryUpdatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([companionId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json        @default("{}")
  creditsUsed    Int         @default(0)
  modelSlug      String?
  isModerated    Boolean     @default(false)
  moderationNote String?
  mediaUrl       String?
  mediaType      String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─── Credits & Billing ────────────────────────────────────────────────────────

model CreditWallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

model CreditTransaction {
  id          String          @id @default(uuid())
  userId      String
  walletId    String
  amount      Int
  type        TransactionType
  description String
  referenceId String?
  metadata    Json            @default("{}")
  balanceAfter Int

  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@map("credit_transactions")
}

model PricingRule {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  actionType  String
  modelSlug   String?
  planSlug    String?
  creditCost  Int
  isEnabled   Boolean @default(true)
  metadata    Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([actionType])
  @@map("pricing_rules")
}

// ─── Plans & Subscriptions ────────────────────────────────────────────────────

model Plan {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  description           String?
  monthlyPrice          Int      @default(0)
  yearlyPrice           Int      @default(0)
  monthlyCredits        Int      @default(0)
  companionLimit        Int      @default(1)
  memoryLimitTokens     Int      @default(4000)
  features              Json     @default("[]")
  limits                Json     @default("{}")
  modelTier             String   @default("standard")
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  stripeProductId       String?
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  metadata             Json               @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

// ─── AI Providers & Models ────────────────────────────────────────────────────

model AiProvider {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  description  String?
  baseUrl      String?
  providerType String  @default("CHAT")
  authType     String  @default("api_key")
  secretKeyRef String?
  isEnabled    Boolean @default(true)
  settings     Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models AiModel[]

  @@map("ai_providers")
}

model AiModel {
  id              String    @id @default(uuid())
  providerId      String
  name            String
  slug            String    @unique
  description     String?
  modelType       ModelType
  externalModelId String
  capabilities    Json      @default("{}")
  inputSchema     Json      @default("{}")
  outputSchema    Json      @default("{}")
  supportsStreaming Boolean  @default(false)
  supportsAsync    Boolean  @default(false)
  safetyTier       String   @default("standard")
  isEnabled        Boolean  @default(true)
  settings         Json     @default("{}")
  creditCostPerCall Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider      AiProvider     @relation(fields: [providerId], references: [id])
  modelDefaults ModelDefault[]

  @@index([modelType])
  @@index([isEnabled])
  @@map("ai_models")
}

model ModelDefault {
  id        String    @id @default(uuid())
  modelType ModelType @unique
  modelId   String
  setBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model AiModel @relation(fields: [modelId], references: [id])

  @@map("model_defaults")
}

// ─── Media Generations ────────────────────────────────────────────────────────

model MediaGeneration {
  id              String           @id @default(uuid())
  userId          String
  companionId     String?
  conversationId  String?
  type            MediaType
  status          GenerationStatus @default(PENDING)
  prompt          String           @db.Text
  negativePrompt  String?          @db.Text
  userRequest     String?          @db.Text
  aspectRatio     String?
  style           String?
  durationSeconds Int?
  modelSlug       String?
  providerJobId   String?
  storageKey      String?
  storageUrl      String?
  thumbnailUrl    String?
  creditsUsed     Int              @default(0)
  creditsReserved Int              @default(0)
  reservationId   String?
  metadata        Json             @default("{}")
  errorMessage    String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion Companion? @relation(fields: [companionId], references: [id])

  @@index([userId])
  @@index([companionId])
  @@index([status])
  @@index([providerJobId])
  @@map("media_generations")
}

// ─── Moderation ───────────────────────────────────────────────────────────────

model ModerationEvent {
  id           String           @id @default(uuid())
  userId       String?
  contentType  String
  inputText    String           @db.Text
  action       ModerationAction
  flaggedTerms Json             @default("[]")
  ruleMatched  String?
  metadata     Json             @default("{}")
  ipAddress    String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("moderation_events")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────

model AdminAuditLog {
  id         String @id @default(uuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    Json   @default("{}")
  ipAddress  String?

  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// ─── Credit Reservations ──────────────────────────────────────────────────────

model CreditReservation {
  id          String            @id @default(uuid())
  userId      String
  amount      Int
  status      ReservationStatus @default(RESERVED)
  source      String
  sourceId    String?
  finalizedAt DateTime?
  refundedAt  DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([sourceId])
  @@map("credit_reservations")
}

// ─── Credit Packs ─────────────────────────────────────────────────────────────

model CreditPack {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  description    String?
  credits        Int
  bonusCredits   Int     @default(0)
  price          Int
  currency       String  @default("usd")
  stripePriceId  String?
  isEnabled      Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@map("credit_packs")
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model AppSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String  @db.Text
  description String?
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CompanionStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TransactionType {
  CREDIT_PURCHASE
  CREDIT_GRANT
  CREDIT_DEDUCTION
  CREDIT_REFUND
  CREDIT_RESERVATION
  CREDIT_RESERVATION_FINALIZE
  CREDIT_RESERVATION_REFUND
  SUBSCRIPTION_GRANT
}

enum ReservationStatus {
  RESERVED
  FINALIZED
  REFUNDED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum ModelType {
  CHAT
  IMAGE
  VIDEO
}

enum MediaType {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  QUEUED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ModerationAction {
  BLOCKED
  FLAGGED
  ALLOWED
  AUTO_MODIFIED
}
